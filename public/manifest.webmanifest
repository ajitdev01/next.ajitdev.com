{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "https://next.ajitdev.com/",
  "name": "AJITDEV — Next.js Engineering & Developer Tools",
  "short_name": "AJITDEV",
  "description": "Central developer platform by Ajit Dev covering full stack engineering, DevOps, DevSecOps, cloud architecture, system design, DSA, and modern developer tools.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "lang": "en-US",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": [
    "development",
    "productivity",
    "utilities",
    "education"
  ],
  "shortcuts": [
    {
      "name": "Todo App",
      "short_name": "Todos",
      "description": "Local-First Private Task Manager",
      "url": "/todo",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Notes App",
      "short_name": "Notes",
      "description": "Minimalist Local-First Markdown Notes",
      "url": "/note",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "API Hub",
      "short_name": "APIs",
      "description": "Free Public REST and JSON APIs",
      "url": "/api",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Projects Showcase",
      "short_name": "Projects",
      "description": "Live Software Applications by Ajit Dev",
      "url": "/projects",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "icons": [
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
